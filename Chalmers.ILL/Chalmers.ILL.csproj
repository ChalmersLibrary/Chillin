<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Chalmers.ILL</RootNamespace>
    <AssemblyName>Chalmers.ILL</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- members.json itself is no longer read from here (fas 6, isolerat läge steg A, "Datarot")
         - IChillinConfiguration.DataPath is now the only source of truth for where it lives. The
         .example.json template stays for reference. chillinPrevalues.json doesn't exist any more
         at all (fas 10, avstämt 2026-09-18) - hardcoded in UmbracoApi/ChillinOrderConfiguration.cs
         instead. -->
    <Content Update="Config\members.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Config\log4net.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded search index on disk, replacing Elasticsearch (see OrderItems/LuceneOrderItemSearcher).
         Lucene is the engine Elasticsearch itself is built on, so query_string syntax carries over.
         4.8 has been in beta for years but is the line every .NET Lucene user is on. -->
    <PackageReference Include="Lucene.Net" Version="4.8.0-beta00017" />
    <PackageReference Include="Lucene.Net.Analysis.Common" Version="4.8.0-beta00017" />
    <PackageReference Include="Lucene.Net.QueryParser" Version="4.8.0-beta00017" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.0" />
    <PackageReference Include="log4net" Version="3.4.0" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.90.0" />
    <PackageReference Include="Microsoft.IdentityModel.Abstractions" Version="8.22.0" />
    <!-- Newtonsoft.Json 8.0.1 predates netstandard support and cannot be restored for
         net10.0 - bumped to a version with a net-modern target. No API used here changed. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <!-- WindowsAzure.Storage (legacy SDK, .NET Framework-only) replaced by Azure.Storage.Blobs
         in BlobStorageMediaItemManager - this was fas 8, pulled forward because the old
         package's dependency chain (Microsoft.Data.OData etc.) cannot target net10.0. -->
    <PackageReference Include="Azure.Storage.Blobs" Version="12.24.0" />
    <!-- EWS-Api-2.0 (Exchange Web Services managed API) is .NET Framework-only and has no
         net10.0-compatible build. Graph is the confirmed production mail path (see CLAUDE.md
         designbeslut), so EWS is removed entirely here instead of migrated - this is fas 8's
         "Ta bort EWS helt", pulled forward because the package physically cannot restore for
         net10.0, not because fas 8 was otherwise ready. -->
  </ItemGroup>

</Project>
